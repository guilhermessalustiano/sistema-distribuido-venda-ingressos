{
  "name": "sistema-distribuido-venda-ingressos",
  "version": "0.1.0",
  "private": true,
  "description": "Venda de ingressos de um único Evento: front estático (Vercel) falando direto com PostgreSQL (Supabase) via funções RPC.",
  "type": "module",
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop --no-backup",
    "db:reset": "supabase db reset",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "front": "node scripts/servir-front.js"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.118.0",
    "supabase": "3.0.0"
  }
}
